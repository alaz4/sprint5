      {
        "id": "18f2ae6d-b60e-42a2-a8c7-e8c3d6e5b496",
        "name": "16 Yaklaşan etkinlikler",
        "request": {
          "url": {
            "path": [
              "events",
              "upcoming"
            ],
            "host": [
              "{{baseUrl}}"
            ],
            "query": [],
            "variable": []
          },
          "method": "GET"
        },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "id": "82d74d1e-4b45-4c1f-9b2f-bf27d63d8e2d",
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                "const list = pm.response.json();",
                "const d = (s) => { const [g, a, y] = s.split(\"-\").map(Number); return Date.UTC(y, a - 1, g); };",
                "const n = new Date(); const bugun = Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate());",
                "pm.test(\"geçmiş tarihli yok\", () => list.forEach((e) => pm.expect(d(e.date), e.date).to.be.at.least(bugun)));",
                "pm.test(\"en yakın önce\", () => list.forEach((e, i) => i && pm.expect(d(e.date)).to.be.at.least(d(list[i - 1].date))));",
                "pm.test(\"seed'deki geçmiş etkinlikler elendi\", () => pm.expect(list.length).to.be.below(Number(pm.collectionVariables.get(\"toplam\")) + 1));"
              ],
              "_lastExecutionId": "c99f89fe-5581-4272-82fb-a4bb205babf5"
            }
          }
        ]
      },
