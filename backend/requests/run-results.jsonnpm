          {
            "listen": "test",
            "script": {
              "id": "f9e1de49-65e8-4932-919d-4b9890a9c8fe",
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                "const b = pm.response.json();",
                "pm.test(\"status ok\", () => pm.expect(b.status).to.eql(\"ok\"));",
                "pm.test(\"student dolu\", () => pm.expect(String(b.student || \"\")).to.match(/\\d{6,}/));"
              ],
              "_lastExecutionId": "8546c9ee-54c5-4f2b-9bbc-aa0acb63f83f"
            }
          }
        ]
      },
      {
        "id": "13295b4f-485c-47e8-93cb-b2297e248bd1",
        "name": "02 Etkinlik listesi",
        "request": {
          "url": {
            "path": [
              "events"
            ],
            "host": [
              "{{baseUrl}}"
            ],
            "query": [],
            "variable": []
          },
          "method": "GET"
        },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "id": "5627bc2a-3adb-4285-b38a-b6144fca4e93",
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                "const tarihOk = (d) => /^\\d{2}-\\d{2}-\\d{4}$/.test(d);",
                "const list = pm.response.json();",
                "pm.test(\"en az 6 kayıt\", () => pm.expect(list.length).to.be.at.least(6));",
                "pm.test(\"tarihler GG-AA-YYYY\", () => list.forEach((e) => pm.expect(tarihOk(e.date), e.date).to.be.true));",
                "pm.test(\"_id ve createdAt var\", () => pm.expect(list[0]).to.have.property(\"_id\") && pm.expect(list[0]).to.have.property(\"createdAt\"));",
                "pm.collectionVariables.set(\"eventId\", list[0]._id);",
                "pm.collectionVariables.set(\"toplam\", list.length);"
              ],
              "_lastExecutionId": "9a7067d6-7b8a-4b18-8b71-9ab8958105df"
            }
          }
        ]
      },
